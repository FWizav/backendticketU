# Credenciales de DESARROLLO para RabbitMQ.
# Cámbienlas en un despliegue real y no suban el archivo .env al repositorio.
RABBITMQ_USER=ticketu
RABBITMQ_PASSWORD=ticketu_dev
RABBITMQ_VHOST=ticketu

# URL que usan los scripts de ejemplo cuando se ejecutan desde el HOST.
BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu

# Exchange común de eventos de dominio para los 9 microservicios.
EVENT_EXCHANGE=ticketu.events

# Cola usada por el consumidor de ejemplo.
# Un microservicio real debe usar una cola estable y propia, por ejemplo:
# notificaciones.eventos, entradas.pagos, organizador.checkins
QUEUE_NAME=demo.notificaciones
