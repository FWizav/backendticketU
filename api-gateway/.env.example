# Puerto público del Gateway
PORT=8080

# Orígenes del front permitidos por CORS, separados por coma.
# Para desarrollo local del front:
CORS_ORIGINS=http://localhost:3000

# Tiempo máximo de espera por un microservicio (milisegundos)
PROXY_TIMEOUT_MS=5000

# URLs internas de los 9 microservicios cuando todos están en la red Docker
# compartida "plataforma-eventos-net".
# Cada grupo debe usar un nombre de servicio Docker único y estable.
AUTH_SERVICE_URL=http://auth-service:3000
CATALOGO_SERVICE_URL=http://catalogo-service:3000
ENTRADAS_SERVICE_URL=http://entradas-service:3000
PAGOS_SERVICE_URL=http://pagos-service:3000
CHECKIN_SERVICE_URL=http://checkin-service:3000
RESENAS_SERVICE_URL=http://resenas-service:3000
ORGANIZADOR_SERVICE_URL=http://organizador-service:3000
NOTIFICACIONES_SERVICE_URL=http://notificaciones-service:3000
PROMOCIONES_SERVICE_URL=http://promociones-service:3000

# Si ejecutas Gateway y microservicios SIN Docker, reemplaza las URLs anteriores
# por localhost con los puertos reales de cada grupo, por ejemplo:
# CATALOGO_SERVICE_URL=http://localhost:3002
